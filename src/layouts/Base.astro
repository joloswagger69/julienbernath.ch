---
/* ==========================================================================
   Grundlayout für alle Seiten
   Sprache, Titel, Beschreibung, Canonical, hreflang, Open Graph, Theme ohne
   Aufblitzen, Schrift-Preload, Kopfzeile, Timeline, Fusszeile.
   ========================================================================== */
import '../styles/base.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Timeline from '../components/Timeline.astro';
import { PREVIEW } from '../config';
import { THEME_INIT } from '../lib/theme-init.mjs';
import { defaultLang, locales, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
    lang: Lang;
    /** Adresse dieser Seite in jeder Sprache, z.B. { de: '/arbeiten/', en: '/en/work/' } */
    alternates: Record<Lang, string>;
    title?: string;
    description?: string;
    /** Vorschaubild für Social Media (absolute oder relative URL) */
    ogImage?: string;
    noindex?: boolean;
    /** Englische Seite zeigt noch den deutschen Originalinhalt */
    untranslated?: boolean;
    /** Kontakt-Aufruf in der Fusszeile zeigen (auf der Kontaktseite nicht nötig) */
    footerCta?: boolean;
}

const { lang, alternates, title, description, ogImage, noindex = false, untranslated = false, footerCta = true } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://julienbernath.ch');
const pageTitle = title ?? t('site.title');
const pageDescription = description ?? t('site.description');
const canonical = new URL(alternates[lang], site).href;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
const langs = Object.keys(alternates) as Lang[];
const robotsNoindex = noindex || PREVIEW;
---
<!doctype html>
<html lang={locales[lang].html}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Julien Bernath" />
    {/* Sicherheit: Fremdseiten erhalten nur die Domain, nie den vollständigen Pfad */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#DCDDD8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161615" media="(prefers-color-scheme: dark)" />
    {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonical} />
    {langs.map((code) => (
        <link rel="alternate" hreflang={locales[code].html} href={new URL(alternates[code], site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Julien Bernath" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locales[lang].og} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hell/Dunkel vor dem ersten Rendern setzen (gleicher Speicher-Schlüssel wie bisher) -->
    <script is:inline set:html={THEME_INIT}></script>
    <slot name="head" />
</head>
<body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    {PREVIEW && <p class="preview-badge tc">{t('preview.badge')}</p>}
    <Header lang={lang} alternates={alternates} />
    {untranslated && <p class="en-notice wrap" role="note">{t('en.notice')}</p>}
    <main id="main" tabindex="-1" lang={untranslated ? locales.de.html : undefined}>
        <slot />
    </main>
    <Footer lang={lang} cta={footerCta} />
    <Timeline lang={lang} />
</body>
</html>

<style>
    .preview-badge { background: var(--ink); color: var(--base); font-size: 0.75rem; padding: 5px var(--gutter); text-align: center; }
    .en-notice { margin-top: 20px; padding-block: 12px; color: var(--muted); border-bottom: 1px solid var(--line); }
    main:focus { outline: none; }
</style>
