---
/* ==========================================================================
   Grundlayout für alle Seiten
   Kümmert sich um: Sprache, Titel, Beschreibung, Canonical, hreflang,
   Open Graph, Theme (Hell/Dunkel ohne Aufblitzen), Skip-Link, Navigation.
   Gestaltung von Header und Footer ist provisorisch und folgt in Phase 3.
   ========================================================================== */
import '../styles/base.css';
import LangSwitch from '../components/LangSwitch.astro';
import { PREVIEW } from '../config';
import { defaultLang, locales, type Lang } from '../i18n/ui';
import { path, useTranslations } from '../i18n/utils';

interface Props {
    lang: Lang;
    /** Adresse dieser Seite in jeder Sprache, z.B. { de: '/arbeiten/', en: '/en/work/' } */
    alternates: Record<Lang, string>;
    title?: string;
    description?: string;
    /** Vorschaubild für Social Media (absolute oder relative URL) */
    ogImage?: string;
    /** Seite nicht in Suchmaschinen aufnehmen */
    noindex?: boolean;
    /** Englische Seite zeigt noch den deutschen Originalinhalt */
    untranslated?: boolean;
}

const { lang, alternates, title, description, ogImage, noindex = false, untranslated = false } = Astro.props;
const t = useTranslations(lang);

const site = Astro.site ?? new URL('https://julienbernath.ch');
const pageTitle = title ?? t('site.title');
const pageDescription = description ?? t('site.description');
const canonical = new URL(alternates[lang], site).href;
const ogImageUrl = ogImage ? new URL(ogImage, site).href : undefined;
const langs = Object.keys(alternates) as Lang[];
const robotsNoindex = noindex || PREVIEW;
const current = Astro.url.pathname;
const nav = [
    { href: path('work', lang), label: t('nav.work') },
    { href: path('about', lang), label: t('nav.about') },
    { href: path('tools', lang), label: t('nav.tools') },
    { href: path('contact', lang), label: t('nav.contact') }
];
---
<!doctype html>
<html lang={locales[lang].html}>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Julien Bernath" />
    <meta name="theme-color" content="#DCDDD8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1E1F1C" media="(prefers-color-scheme: dark)" />
    {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonical} />
    {langs.map((code) => (
        <link rel="alternate" hreflang={locales[code].html} href={new URL(alternates[code], site).href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Julien Bernath" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={locales[lang].og} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Hell/Dunkel vor dem ersten Rendern setzen (gleicher Speicher-Schlüssel wie bisher) -->
    <script is:inline>
        try { var t = localStorage.getItem('jb2-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
    <slot name="head" />
</head>
<body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    {PREVIEW && <p class="preview-badge tc">{t('preview.badge')}</p>}
    <header class="topbar-temp">
        <a class="brand" href={path('home', lang)} aria-label="Julien Bernath">
            <span class="brand-j">J</span><span class="brand-b">B</span>
        </a>
        <nav class="nav-temp" aria-label={t('nav.label')}>
            {nav.map((n) => (
                <a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
            ))}
        </nav>
        <LangSwitch lang={lang} alternates={alternates} />
    </header>
    {untranslated && <p class="en-notice" role="note">{t('en.notice')}</p>}
    <main id="main" lang={untranslated ? locales.de.html : undefined}>
        <slot />
    </main>
    <footer class="footer-temp">
        <span>© {new Date().getFullYear()} Julien Bernath</span>
        <a id="privacy-open" href={path('privacy', lang)}>{t('footer.privacy')}</a>
    </footer>
</body>
</html>

<style>
    /* Provisorisch (Phase 2) – wird in Phase 3 durch den echten Header/Footer ersetzt */
    .preview-badge { background: var(--ink); color: var(--base); font-size: 0.75rem; padding: 4px var(--gutter); }
    .topbar-temp {
        min-height: var(--top-h); padding: 8px var(--gutter);
        display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; justify-content: space-between;
        border-bottom: 1px solid var(--line);
    }
    .brand { font-weight: 900; font-stretch: 75%; font-size: 1.5rem; letter-spacing: -0.02em; text-decoration: none; line-height: 1; }
    .brand-b { color: var(--red); }
    .nav-temp { display: flex; flex-wrap: wrap; gap: 4px 18px; }
    .nav-temp a { text-decoration: none; padding: 4px 0; }
    .nav-temp a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--red); }
    .en-notice { margin: 16px var(--gutter) 0; padding: 10px 14px; border: 1px solid var(--line-strong); max-width: 70ch; }
    .footer-temp { display: flex; gap: 24px; padding: 32px var(--gutter); border-top: 1px solid var(--line); margin-top: 64px; color: var(--muted); }
</style>
