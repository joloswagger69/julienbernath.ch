---
/* Eine Seite pro Projekt – wird für alle 13 Projekte automatisch erzeugt. */
import Page from '../../components/pages/ProjectPage.astro';
import { getProjects, slugOf } from '../../lib/projects';

export async function getStaticPaths() {
    const list = await getProjects('de');
    return list.map(({ project }) => ({ params: { slug: slugOf(project) }, props: { project } }));
}
const { project } = Astro.props;
---
<Page lang="de" project={project} />
