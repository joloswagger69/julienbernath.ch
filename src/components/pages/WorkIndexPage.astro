---
/* Alle Arbeiten: 13 Projekte in der bisherigen Reihenfolge, Filter wie bisher
   (Alle / Foto / Video / Design). Ohne JavaScript sind alle Projekte sichtbar. */
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import { KIND_LABEL, getProjects } from '../../lib/projects';
import { meta } from '../../data/site';
import { alternates, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = (await getProjects(lang)).map((p) => p.project);
const kinds = (['photo', 'video', 'design'] as const).map((k) => ({ k, n: projects.filter((p) => p.data.kind === k).length }));
---
<Base lang={lang} alternates={alternates('work')} title={meta[lang].work.title} description={meta[lang].work.description}>
    <section class="wrap head" data-clip={t('home.clip.work')}>
        <h1 class="h1">{t('work.all')}</h1>
        <div class="filters" role="group" aria-label={t('work.filter')} data-filters hidden>
            <button type="button" data-filter="all" aria-pressed="true">{t('work.filterAll')} <span class="tc">{projects.length}</span></button>
            {kinds.map(({ k, n }) => (
                <button type="button" data-filter={k} aria-pressed="false"><span class="label" data-kind={k}>{KIND_LABEL[k][lang]}</span> <span class="tc">{n}</span></button>
            ))}
        </div>
    </section>

    <section class="wrap">
        <ul class="grid" data-grid>
            {projects.map((project, i) => (
                <li data-kind={project.data.kind}>
                    <ProjectCard project={project} lang={lang} eager={i === 0} ratio="3 / 2" level="h2" />
                </li>
            ))}
        </ul>
        <p class="visually-hidden" aria-live="polite" data-status data-template={t('work.filterStatus')}></p>
    </section>
</Base>

<script>
    const group = document.querySelector<HTMLElement>('[data-filters]');
    const items = [...document.querySelectorAll<HTMLElement>('[data-grid] > li')];
    const status = document.querySelector<HTMLElement>('[data-status]');
    if (group) {
        group.hidden = false;
        const buttons = [...group.querySelectorAll<HTMLButtonElement>('button')];
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        buttons.forEach((b) => b.addEventListener('click', () => {
            const f = b.dataset.filter!;
            if (b.getAttribute('aria-pressed') === 'true') return;
            // FLIP: Positionen vorher merken, umschalten, Clips gleiten an den neuen Platz
            const before = new Map(items.filter((li) => !li.hidden).map((li) => [li, li.getBoundingClientRect()]));
            buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
            let n = 0;
            items.forEach((li) => { const on = f === 'all' || li.dataset.kind === f; li.hidden = !on; if (on) n++; });
            if (status) status.textContent = status.dataset.template!.replace('{n}', String(n));
            if (f !== 'all') document.dispatchEvent(new CustomEvent('jb:fx', { detail: 'filter' }));
            if (reduced) return;
            items.forEach((li) => {
                if (li.hidden) return;
                const a = before.get(li), r = li.getBoundingClientRect();
                if (!a) { li.animate([{ opacity: 0, transform: 'scale(0.97)' }, { opacity: 1, transform: 'none' }], { duration: 320, easing: 'ease-out' }); return; }
                const dx = a.left - r.left, dy = a.top - r.top;
                if (dx || dy) li.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'none' }], { duration: 420, easing: 'cubic-bezier(.2,.7,.1,1)' });
            });
        }));
    }
</script>

<style>
    .head { padding-top: clamp(32px, 6vw, 80px); display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px 40px; margin-bottom: clamp(28px, 4vw, 56px); }
    .filters { display: flex; flex-wrap: wrap; gap: 8px; }
    .filters button {
        display: inline-flex; align-items: center; gap: 10px;
        min-height: 42px; padding: 0 14px;
        border: 1px solid var(--line-strong); border-radius: 2px; font-weight: 600;
    }
    .filters button .label { color: inherit; font-size: inherit; }
    .filters button .tc { color: var(--muted); font-size: var(--step--1); }
    .filters button[aria-pressed='true'] { background: var(--ink); color: var(--base); border-color: var(--ink); }
    .filters button[aria-pressed='true'] .tc { color: inherit; }
    .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 6vw, 80px) clamp(16px, 2.4vw, 32px); }
    @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>
