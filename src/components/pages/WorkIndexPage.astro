---
/* Alle Arbeiten (provisorisch): 13 Projekte in der bisherigen Reihenfolge.
   Der Filter (Alle / Foto / Video / Design) folgt in Phase 3. */
import Base from '../../layouts/Base.astro';
import ProjectCard from '../ProjectCard.astro';
import { getProjects } from '../../lib/projects';
import { alternates, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---
<Base lang={lang} alternates={alternates('work')} title={`${t('work.all')} | Julien Bernath`} untranslated={lang !== 'de'}>
    <section class="block">
        <h1>{t('work.all')} <span class="tc count">({projects.length})</span></h1>
        <ul class="grid">
            {projects.map(({ project }, i) => <li><ProjectCard project={project} lang={lang} eager={i < 2} /></li>)}
        </ul>
    </section>
</Base>

<style>
    .block { padding: 48px var(--gutter) 0; }
    h1 { font-size: clamp(2rem, 6vw, 3.5rem); font-stretch: 75%; margin-bottom: 24px; }
    .count { font-size: 1rem; color: var(--muted); font-weight: 400; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 32px 24px; }
</style>
