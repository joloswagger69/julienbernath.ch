---
/* Kontakt: Aufruf, E-Mail (kopieren), LinkedIn, Ort mit Ortszeit und das
   unveränderte Web3Forms-Formular. */
import Base from '../../layouts/Base.astro';
import ContactForm from '../ContactForm.astro';
import { contact, meta, person } from '../../data/site';
import { alternates, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<Base lang={lang} alternates={alternates('contact')} title={meta[lang].contact.title} description={meta[lang].contact.description} footerCta={false}>
    <section class="wrap contact" data-clip={t('contact.title')}>
        <div class="left">
            <h1 class="h1">{contact[lang].title}</h1>
            <p class="lede">{contact[lang].lede}</p>
            <a class="mail" id="contact-mail" href={`mailto:${person.email}`}>{person.email}</a>
            <p class="actions">
                <button type="button" class="btn" data-copy={person.email} data-done={t('contact.copied')}>{t('contact.copy')}</button>
                <a class="btn" href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </p>
            <p class="loc muted">{contact[lang].location} <span><span class="visually-hidden">{t('contact.localTime')}: </span><span class="tc" data-clock></span></span></p>
        </div>
        <div class="right">
            <ContactForm lang={lang} />
        </div>
    </section>
</Base>

<script>
    const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
    copy?.addEventListener('click', async (e) => {
        // Für den Spielmodus (Papierflieger); ohne Spielmodus hört niemand zu
        document.dispatchEvent(new CustomEvent('jb:plane', { detail: { x: e.clientX, y: e.clientY } }));
        const label = copy.textContent;
        try { await navigator.clipboard.writeText(copy.dataset.copy!); copy.textContent = copy.dataset.done!; }
        catch (e) { copy.textContent = copy.dataset.copy!; }
        setTimeout(() => { copy.textContent = label; }, 2200);
    });
    const clock = document.querySelector<HTMLElement>('[data-clock]');
    if (clock) {
        const tick = () => { clock.textContent = new Date().toLocaleTimeString('de-CH', { timeZone: 'Europe/Zurich', hour12: false }); };
        tick(); setInterval(tick, 1000);
    }
</script>

<style>
    .contact { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 96px); padding-top: clamp(32px, 6vw, 80px); align-items: start; }
    .left { position: sticky; top: calc(var(--top-h) + 24px); }
    .lede { margin-top: 20px; }
    .mail {
        display: inline-block; margin-top: 32px;
        font-size: clamp(1.7rem, 3.6vw, 3rem); font-weight: 860; font-stretch: 66%;
        line-height: 1; text-decoration: none; overflow-wrap: anywhere;
    }
    .mail:hover { color: var(--red); }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .loc { margin-top: 24px; display: flex; gap: 12px; flex-wrap: wrap; }
    .loc .tc { color: var(--red-ink); }
    @media (max-width: 960px) {
        .contact { grid-template-columns: 1fr; }
        .left { position: static; }
    }
</style>
