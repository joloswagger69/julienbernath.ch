---
/* Datenschutz: wortgleicher Text, gut lesbar gesetzt. */
import Base from '../../layouts/Base.astro';
import PrivacyText from '../PrivacyText.astro';
import { alternates, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<Base lang={lang} alternates={alternates('privacy')} title={`${t('privacy.title')} | Julien Bernath`} untranslated={lang !== 'de'}>
    <section class="wrap privacy" data-clip={t('privacy.title')}>
        <h1 class="h1">{t('privacy.title')}</h1>
        <div class="text">
            <PrivacyText />
        </div>
    </section>
</Base>

<style>
    .privacy { padding-top: clamp(32px, 6vw, 80px); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 5vw, 80px); align-items: start; }
    .privacy h1 { position: sticky; top: calc(var(--top-h) + 24px); }
    .text { max-width: 66ch; }
    .text :global(h2) { font-size: var(--step-1); font-weight: 760; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); }
    .text :global(p) { margin-top: 12px; }
    .text :global(p:first-child) { font-size: var(--step-1); line-height: 1.45; margin-top: 0; }
    .text :global(.privacy-date) { margin-top: 40px; color: var(--muted); font-size: var(--step--1); }
    @media (max-width: 860px) {
        .privacy { grid-template-columns: 1fr; }
        .privacy h1 { position: static; }
    }
</style>
