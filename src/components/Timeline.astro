---
/* Dezente Timeline am unteren Rand: Playhead = Scroll-Position, Timecode,
   Marker für die Abschnitte der Seite (Elemente mit data-clip="Name").
   Ein Klick auf die Spur springt an die Stelle. Ohne JavaScript unsichtbar. */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<div class="timeline" data-timeline hidden>
    <span class="tl-tc tc" data-tl-tc aria-hidden="true">00:00:00:00</span>
    <div class="tl-track" data-tl-track role="slider" tabindex="0" aria-label={t('timeline.label')}
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="tl-clips" data-tl-clips aria-hidden="true"></div>
        <span class="tl-head" data-tl-head aria-hidden="true"></span>
    </div>
</div>

<script>
    const el = document.querySelector<HTMLElement>('[data-timeline]');
    if (el) {
        el.hidden = false;
        const track = el.querySelector<HTMLElement>('[data-tl-track]')!;
        const clips = el.querySelector<HTMLElement>('[data-tl-clips]')!;
        const head = el.querySelector<HTMLElement>('[data-tl-head]')!;
        const tc = el.querySelector<HTMLElement>('[data-tl-tc]')!;
        const FPS = 25, TOTAL = 90; // die ganze Seite entspricht 90 Sekunden Material
        const max = () => Math.max(1, document.documentElement.scrollHeight - innerHeight);
        const p2 = (n: number) => String(n).padStart(2, '0');
        const timecode = (frac: number) => {
            const f = Math.floor(frac * TOTAL * FPS), s = Math.floor(f / FPS);
            return `${p2(Math.floor(s / 3600))}:${p2(Math.floor(s / 60) % 60)}:${p2(s % 60)}:${p2(f % FPS)}`;
        };
        let ranges: { node: HTMLElement; start: number; end: number; clip: HTMLElement }[] = [];

        function layout() {
            const sections = [...document.querySelectorAll<HTMLElement>('[data-clip]')];
            const m = max();
            clips.innerHTML = '';
            ranges = sections.map((node, i) => {
                const at = (n: HTMLElement) => Math.min(1, Math.max(0, (n.getBoundingClientRect().top + scrollY - innerHeight * 0.35) / m));
                const start = i === 0 ? 0 : at(node);
                const end = sections[i + 1] ? at(sections[i + 1]) : 1;
                const clip = document.createElement('span');
                clip.className = 'tl-clip';
                clip.textContent = node.dataset.clip!;
                clip.style.left = `${start * 100}%`;
                clip.style.width = `${Math.max(0, end - start) * 100}%`;
                clips.appendChild(clip);
                return { node, start, end, clip };
            });
            update();
        }
        function update() {
            const frac = Math.min(1, Math.max(0, scrollY / max()));
            head.style.transform = `translateX(${frac * track.clientWidth}px)`;
            tc.textContent = timecode(frac);
            track.setAttribute('aria-valuenow', String(Math.round(frac * 100)));
            let current = '';
            for (const r of ranges) {
                const on = (frac >= r.start && frac < r.end) || (frac === 1 && r.end === 1);
                r.clip.classList.toggle('is-current', on);
                if (on) current = r.node.dataset.clip!;
            }
            track.setAttribute('aria-valuetext', `${timecode(frac)}${current ? ` – ${current}` : ''}`);
        }
        const fx = (id: string) => document.dispatchEvent(new CustomEvent('jb:fx', { detail: id }));
        const go = (clientX: number) => {
            const r = track.getBoundingClientRect();
            scrollTo({ top: Math.min(1, Math.max(0, (clientX - r.left) / r.width)) * max(), behavior: 'instant' as ScrollBehavior });
        };
        // Klicken = springen, Ziehen = scrubben (wie in der Schnitt-Timeline)
        let drag = false, moved = false, x0 = 0;
        track.addEventListener('pointerdown', (e) => { drag = true; moved = false; x0 = e.clientX; track.setPointerCapture(e.pointerId); go(e.clientX); });
        track.addEventListener('pointermove', (e) => { if (!drag) return; if (Math.abs(e.clientX - x0) > 4) moved = true; go(e.clientX); });
        track.addEventListener('pointerup', () => { if (drag) fx(moved ? 'scrubtl' : 'clipjump'); drag = false; });
        track.addEventListener('pointercancel', () => { drag = false; });
        // Tastatur: ← → 5 %, Bild ↑/↓ = vorheriger/nächster Abschnitt, Pos1/Ende = Anfang/Ende
        track.addEventListener('keydown', (e) => {
            const frac = Math.min(1, Math.max(0, scrollY / max()));
            let target: number | null = null;
            if (e.key === 'ArrowRight') target = frac + 0.05;
            else if (e.key === 'ArrowLeft') target = frac - 0.05;
            else if (e.key === 'Home') target = 0;
            else if (e.key === 'End') target = 1;
            else if (e.key === 'PageDown') target = ranges.find((r) => r.start > frac + 0.001)?.start ?? 1;
            else if (e.key === 'PageUp') target = [...ranges].reverse().find((r) => r.start < frac - 0.001)?.start ?? 0;
            if (target === null) return;
            e.preventDefault();
            scrollTo({ top: Math.min(1, Math.max(0, target)) * max() });
        });
        let queued = false;
        addEventListener('scroll', () => { if (queued) return; queued = true; requestAnimationFrame(() => { queued = false; update(); }); }, { passive: true });
        let t: number | undefined;
        const relayout = () => { clearTimeout(t); t = window.setTimeout(layout, 150); };
        addEventListener('resize', relayout);
        addEventListener('load', layout);
        if ('ResizeObserver' in window) new ResizeObserver(relayout).observe(document.body);
        layout();
    }
</script>

<style>
    .timeline {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 90;
        height: var(--tl-h);
        display: flex; align-items: stretch;
        background: var(--base);
        border-top: 1px solid var(--line);
    }
    .tl-tc { flex: none; display: flex; align-items: center; padding: 0 12px 0 var(--gutter); font-size: 0.8125rem; color: var(--red-ink); }
    .tl-track { position: relative; flex: 1; margin-right: var(--gutter); cursor: ew-resize; touch-action: none; }
    .tl-track:focus-visible { outline-offset: -2px; }
    .tl-clips { position: absolute; inset: 7px 0; }
    :global(.tl-clip) {
        position: absolute; top: 0; bottom: 0;
        padding: 0 8px; border-left: 1px solid var(--base);
        display: flex; align-items: center;
        font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        background: var(--panel); color: var(--muted);
        transition: background-color var(--cut) var(--ease), color var(--cut) var(--ease);
    }
    :global(.tl-clip.is-current) { background: var(--ink); color: var(--base); }
    .tl-head { position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: var(--red); pointer-events: none; }
    .tl-head::before { content: ''; position: absolute; top: 0; left: -4px; border: 5px solid transparent; border-top-color: var(--red); }

    @media (max-width: 600px) {
        :global(.tl-clip) { font-size: 0; padding: 0; }
        .tl-tc { font-size: 0.75rem; }
    }
    @media print { .timeline { display: none; } }
</style>
