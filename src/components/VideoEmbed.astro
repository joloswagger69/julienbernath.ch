---
/* Video mit Klick-zum-Laden: Erst beim Abspielen wird YouTube bzw. TikTok
   eingebunden (Datenschutz, Ladezeit). Der Link zum Anbieter bleibt immer da. */
import type { Lang } from '../i18n/ui';
import { fmt, useTranslations } from '../i18n/utils';
import { videoUrl } from '../lib/projects';

interface Props {
    lang: Lang;
    video: { type: 'youtube' | 'tiktok'; id: string; label: string; portrait?: boolean };
    title: string;
}
const { lang, video, title } = Astro.props;
const t = useTranslations(lang);
const provider = video.type === 'youtube' ? 'YouTube' : 'TikTok';
const portrait = video.type === 'tiktok' || !!video.portrait;
const src = video.type === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${video.id}?autoplay=1&rel=0`
    : `https://www.tiktok.com/embed/v2/${video.id}`;
---
<figure class:list={['video', { portrait }]}>
    <div class="frame" data-embed={src} data-title={title}>
        <button type="button" class="play" data-play>
            <span class="play-icon" aria-hidden="true"><svg viewBox="0 0 10 12"><path d="M0 0l10 6-10 6z" /></svg></span>
            <span class="play-text">{t('project.playVideo')}</span>
            <span class="play-note">{fmt(t('project.videoNote'), { provider })}</span>
        </button>
    </div>
    <figcaption class="video-cap">
        <span class="tc">{video.label.replace(/\.URL$/, '').replace(/_/g, ' ')}</span>
        <a href={videoUrl(video)} target="_blank" rel="noopener noreferrer">{fmt(t('project.openOn'), { provider })}</a>
    </figcaption>
</figure>

<script>
    document.querySelectorAll<HTMLElement>('[data-embed]').forEach((frame) => {
        frame.querySelector('[data-play]')?.addEventListener('click', () => {
            const f = document.createElement('iframe');
            f.src = frame.dataset.embed!;
            f.title = frame.dataset.title!;
            f.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
            f.referrerPolicy = 'strict-origin-when-cross-origin';
            frame.replaceChildren(f);
            f.focus();
        }, { once: true });
    });
</script>

<style>
    .video { margin: 0; }
    .frame { position: relative; aspect-ratio: 16 / 9; background: var(--monitor); color: #F1F1EC; border-radius: 3px; overflow: hidden; }
    .portrait .frame { aspect-ratio: 9 / 16; width: min(100%, calc(82vh * 9 / 16)); margin-inline: auto; }
    .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .play { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 10px; padding: 24px; text-align: center; color: inherit; }
    .play-icon { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: var(--red); transition: transform var(--cut) var(--ease); }
    .play-icon svg { width: 22px; height: 26px; fill: #fff; margin-left: 4px; }
    .play:hover .play-icon { transform: scale(1.08); }
    .play-text { font-weight: 700; font-size: var(--step-1); }
    .play-note { font-size: var(--step--1); opacity: 0.75; max-width: 34ch; }
    .video-cap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 16px; margin-top: 10px; font-size: var(--step--1); color: var(--muted); }
    .portrait .video-cap { max-width: calc(82vh * 9 / 16); margin-inline: auto; }
</style>
