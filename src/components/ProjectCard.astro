---
/* Projekt im Raster: grosses Bild ohne Rahmen, darunter Titel, Kunde/Jahr und
   Clip-Label (Kategorie). Seitenverhältnis je nach Platz im Editorial-Raster. */
import { Image } from 'astro:assets';
import SiteGraphic from './SiteGraphic.astro';
import { KIND_LABEL, coverOf, lengthLabel, projectPath, slugOf, type Project } from '../lib/projects';
import type { Lang } from '../i18n/ui';

interface Props {
    project: Project;
    lang: Lang;
    eager?: boolean;
    /** CSS-Seitenverhältnis des Bildes, z.B. "16 / 9" */
    ratio?: string;
    /** sizes-Attribut für responsive Bilder */
    sizes?: string;
    /** Überschriften-Ebene im Kontext der Seite */
    level?: 'h2' | 'h3';
}
const { project, lang, eager = false, ratio = '3 / 2', sizes = '(max-width: 760px) 100vw, 50vw', level = 'h3' } = Astro.props;
const d = project.data;
const cover = coverOf(project);
const Heading = level;
---
<article class="card" data-kind={d.kind}>
    <a class="card-link" href={projectPath(slugOf(project), lang)}>
        <div class="card-frame" style={`aspect-ratio:${ratio}`}>
            {cover
                ? <Image src={cover} alt="" width={1600} widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
                : <SiteGraphic />}
        </div>
        <div class="card-caption">
            <Heading class="card-title">{d.title}</Heading>
            <p class="card-meta">
                <span class="label" data-kind={d.kind}>{KIND_LABEL[d.kind][lang]}</span>
                <span>{d.client}, {d.year}</span>
                <span class="tc card-len">{lengthLabel(project)}</span>
            </p>
        </div>
    </a>
</article>

<style>
    .card-link { display: block; text-decoration: none; }
    .card-frame { position: relative; overflow: hidden; background: var(--panel); }
    .card-frame :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), filter 0.3s var(--ease); }
    /* Grafiken und Plakate tragen ihren Titel oben – Ausschnitt oben ausrichten */
    .card[data-kind='design'] .card-frame :global(img) { object-position: 50% 0; }
    .card-frame :global(.clip-graphic) { width: 100%; height: 100%; display: grid; place-items: center; padding: 8%; }
    .card-link:hover .card-frame :global(img) { transform: scale(1.025); }
    .card-caption { padding-top: 14px; }
    .card-title { font-size: var(--step-2); font-weight: 820; font-stretch: 78%; line-height: 1; transition: color var(--cut) var(--ease); }
    .card-link:hover .card-title { color: var(--red-ink); }
    .card-meta { display: flex; flex-wrap: wrap; gap: 4px 18px; margin-top: 8px; color: var(--muted); font-size: var(--step--1); }
    .card-len { margin-left: auto; }
    .card-link:focus-visible { outline-offset: 6px; }
</style>
