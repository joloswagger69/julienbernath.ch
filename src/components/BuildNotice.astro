---
/* Provisorischer Inhalt für Phase 1: zeigt, dass Grundgerüst, Schrift,
   Farben und Sprachen funktionieren. Wird in Phase 3 ersetzt. */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="notice">
    <p class="tc notice-tc">00:00:00:00 · v3.0.0-alpha.1</p>
    <h1 class="notice-name"><span>Julien</span> <span class="red">Bernath</span></h1>
    <h2 class="notice-title">{t('build.title')}</h2>
    <p class="notice-text">{t('build.text')}</p>
</section>

<style>
    .notice { padding: clamp(40px, 10vh, 120px) var(--gutter); max-width: 1100px; }
    .notice-tc { color: var(--muted); font-size: 0.875rem; margin-bottom: 24px; }
    .notice-name {
        font-weight: 900; font-stretch: 70%; text-transform: uppercase;
        font-size: clamp(3.5rem, 15vw, 11rem); line-height: 0.86; letter-spacing: -0.02em;
        display: flex; flex-direction: column;
    }
    .red { color: var(--red); }
    .notice-title { margin-top: 40px; font-size: 1.25rem; font-weight: 700; }
    .notice-text { margin-top: 8px; max-width: 52ch; color: var(--ink-soft); }
</style>
