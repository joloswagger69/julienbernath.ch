---
/* Kopfzeile: Logo, Navigation, Sprache, Licht. Auf dem Handy als Vollbild-Menü. */
import LangSwitch from './LangSwitch.astro';
import type { Lang } from '../i18n/ui';
import { path, useTranslations } from '../i18n/utils';

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const current = Astro.url.pathname;
const nav = [
    { href: path('work', lang), label: t('nav.work') },
    { href: path('about', lang), label: t('nav.about') },
    { href: path('tools', lang), label: t('nav.tools') },
    { href: path('contact', lang), label: t('nav.contact') }
];
---
<header class="topbar">
    <div class="topbar-inner wrap">
        <a class="brand" href={path('home', lang)} aria-label={`JB – Julien Bernath, ${t('nav.home')}`}>
            <span>J</span><span class="brand-b">B</span>
        </a>

        <nav class="nav" id="site-nav" aria-label={t('nav.label')}>
            <ul>
                {nav.map((n) => (
                    <li><a href={n.href} aria-current={current.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
                ))}
            </ul>
            <div class="nav-extra">
                <LangSwitch lang={lang} alternates={alternates} />
            </div>
        </nav>

        <div class="actions">
            <button class="theme-btn" type="button" data-theme-toggle aria-label={t('theme.toggle')} title={t('theme.toggle')}>
                <span class="theme-icon" aria-hidden="true"></span>
            </button>
            <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav"
                    data-label-open={t('menu.open')} data-label-close={t('menu.close')}>{t('menu.open')}</button>
        </div>
    </div>
</header>

<script>
    // Licht umschalten – gleicher Speicher-Schlüssel wie die bisherige Website
    const root = document.documentElement;
    const isDark = () => (root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('jb2-theme', next); } catch (e) { /* privater Modus */ }
        document.dispatchEvent(new CustomEvent('jb:fx', { detail: 'light' }));
        document.dispatchEvent(new Event('jb:theme'));
    });

    // Handy-Menü
    const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
    const nav = document.getElementById('site-nav');
    if (btn && nav) {
        const bar = document.querySelector<HTMLElement>('.topbar')!;
        const set = (open: boolean) => {
            // Menü beginnt genau unter der Kopfzeile (auch wenn der Vorschau-Hinweis darüber steht)
            if (open) nav.style.top = `${Math.max(0, bar.getBoundingClientRect().bottom)}px`;
            btn.setAttribute('aria-expanded', String(open));
            btn.textContent = open ? btn.dataset.labelClose! : btn.dataset.labelOpen!;
            nav.classList.toggle('is-open', open);
            document.body.style.overflow = open ? 'hidden' : '';
        };
        btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
        nav.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) set(false); });
        addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('is-open')) { set(false); btn.focus(); } });
        matchMedia('(min-width: 861px)').addEventListener('change', () => set(false));
    }
</script>

<style>
    .topbar {
        position: sticky; top: 0; z-index: 100;
        /* bewusst ohne backdrop-filter: der würde das fixe Handy-Menü in die Kopfzeile einsperren */
        background: var(--base);
        border-bottom: 1px solid var(--line);
    }
    .topbar-inner { height: var(--top-h); display: flex; align-items: center; gap: 24px; }
    .brand { font-weight: 900; font-stretch: 72%; font-size: 1.65rem; letter-spacing: -0.03em; text-decoration: none; line-height: 1; margin-right: auto; }
    .brand-b { color: var(--red); }

    .nav { display: flex; align-items: center; gap: 28px; }
    .nav ul { display: flex; gap: 26px; }
    .nav a { text-decoration: none; font-weight: 550; padding-block: 6px; }
    .nav ul a { background: linear-gradient(var(--red), var(--red)) left bottom / 0 2px no-repeat; transition: background-size var(--cut) var(--ease); }
    .nav ul a:hover, .nav ul a[aria-current='page'] { background-size: 100% 2px; }

    .actions { display: flex; align-items: center; gap: 6px; }
    .theme-btn { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; }
    .theme-btn:hover { background: var(--panel); }
    .theme-icon { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--ink); background: linear-gradient(90deg, var(--ink) 50%, transparent 50%); }
    .menu-btn { display: none; font-weight: 650; min-height: 40px; padding: 0 14px; border: 1px solid var(--ink); border-radius: 2px; }

    @media (max-width: 860px) {
        .menu-btn { display: inline-block; }
        .nav {
            position: fixed; inset: var(--top-h) 0 0 0; z-index: 99;
            flex-direction: column; align-items: stretch; justify-content: space-between; gap: 32px;
            padding: 32px var(--gutter) calc(var(--tl-h) + 32px);
            background: var(--base);
            visibility: hidden; opacity: 0;
            transition: opacity var(--cut) steps(2, end), visibility 0s linear var(--cut);
        }
        .nav.is-open { visibility: visible; opacity: 1; transition: opacity var(--cut) steps(2, end); }
        .nav ul { flex-direction: column; gap: 4px; }
        .nav ul a { display: block; font-size: clamp(2.4rem, 11vw, 3.6rem); font-weight: 860; font-stretch: 68%; text-transform: uppercase; line-height: 1.05; background: none; }
        .nav ul a[aria-current='page'] { color: var(--red); }
    }
</style>
