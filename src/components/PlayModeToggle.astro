---
/* Schalter für den Spielmodus. Die Effekte (public/spielmodus/) werden erst
   nach dem Einschalten geladen – normale Besucher laden davon nichts.
   Der Zustand wird lokal gespeichert (Schlüssel «jb3-play»). Ausschalten
   lädt die Seite neu, damit garantiert alle Effekte weg sind. */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
interface Props { lang: Lang; variant?: 'link' | 'button' }
const { lang, variant = 'link' } = Astro.props;
const t = useTranslations(lang);
---
<button type="button" class:list={['play-toggle', variant === 'button' ? 'btn' : 'play-link']} data-play-toggle
        aria-pressed="false" data-on={t('play.on')} data-off={t('play.off')}>{t('play.on')}</button>

<script>
    const KEY = 'jb3-play';
    const isOn = () => { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } };
    const load = () => {
        if ((window as any).__jbPlayLoading) return;
        (window as any).__jbPlayLoading = true;
        document.documentElement.classList.add('jb-play');
        const css = document.createElement('link');
        css.rel = 'stylesheet'; css.href = '/spielmodus/spielmodus.css?v=1';
        document.head.appendChild(css);
        const js = document.createElement('script');
        js.src = '/spielmodus/spielmodus.js?v=1'; js.defer = true;
        document.head.appendChild(js);
    };
    const paint = () => document.querySelectorAll<HTMLButtonElement>('[data-play-toggle]').forEach((b) => {
        const on = isOn();
        b.setAttribute('aria-pressed', String(on));
        b.textContent = on ? b.dataset.off! : b.dataset.on!;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-play-toggle]').forEach((b) => b.addEventListener('click', () => {
        if (isOn()) {
            try { localStorage.removeItem(KEY); } catch (e) { /* privater Modus */ }
            location.reload();
        } else {
            try { localStorage.setItem(KEY, '1'); } catch (e) { /* privater Modus */ }
            load();
            paint();
        }
    }));
    // Eingeschaltet geblieben? Dann nach dem Laden der Seite nachladen (blockiert nichts)
    if (isOn()) {
        const go = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(load, { timeout: 1500 }) : setTimeout(load, 300));
        document.readyState === 'complete' ? go() : addEventListener('load', go, { once: true });
    }
    paint();
    document.addEventListener('jb:play-off', () => { try { localStorage.removeItem(KEY); } catch (e) {} location.reload(); });
</script>

<style>
    .play-link { text-decoration: underline; text-underline-offset: 0.2em; color: inherit; font-size: inherit; }
    .play-link[aria-pressed='true'] { color: var(--red-ink); }
</style>
