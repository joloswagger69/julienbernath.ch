---
/* Fusszeile: Kontakt-Aufruf (Abspann), Links, «Zurückspulen» wie bisher. */
import type { Lang } from '../i18n/ui';
import { path, useTranslations } from '../i18n/utils';
import { person, status } from '../data/site';

interface Props { lang: Lang; cta?: boolean }
const { lang, cta = true } = Astro.props;
const t = useTranslations(lang);
---
<footer class="footer" data-clip={t('footer.clip')}>
    {cta && (
        <div class="credits wrap">
            <p class="credits-status"><span class="rec-dot is-live" aria-hidden="true"></span>{t('footer.status')}</p>
            <a class="credits-mail" href={`mailto:${person.email}`}>{person.email}</a>
            <p class="credits-links">
                <a class="btn" href={path('contact', lang)}>{t('footer.write')}</a>
                <a class="btn" href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            </p>
        </div>
    )}
    <div class="legal wrap">
        <span>© {new Date().getFullYear()} {person.name} · {status.qualification}</span>
        <a id="privacy-open" href={path('privacy', lang)}>{t('footer.privacy')}</a>
        <a href="#main" class="rewind" data-rewind>{t('footer.rewind')}</a>
    </div>
</footer>

<script>
    document.querySelector('[data-rewind]')?.addEventListener('click', (e) => {
        e.preventDefault();
        scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        document.querySelector<HTMLElement>('.brand')?.focus({ preventScroll: true });
    });
</script>

<style>
    .footer { margin-top: clamp(80px, 12vw, 160px); border-top: 1px solid var(--line); }
    .credits { padding-block: clamp(48px, 8vw, 96px); }
    .credits-status { display: flex; align-items: center; gap: 10px; color: var(--muted); }
    .credits-mail {
        display: inline-block; margin-top: 12px;
        font-size: clamp(1.9rem, 6.4vw, 5.2rem); font-weight: 860; font-stretch: 66%;
        line-height: 1; letter-spacing: -0.01em; text-decoration: none; overflow-wrap: anywhere;
    }
    .credits-mail:hover { color: var(--red); }
    .credits-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
    .legal {
        display: flex; flex-wrap: wrap; gap: 8px 28px; align-items: center;
        padding-block: 22px; border-top: 1px solid var(--line);
        font-size: var(--step--1); color: var(--muted);
    }
    .legal a { color: inherit; }
    .rewind { margin-left: auto; }
</style>
